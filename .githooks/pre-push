#!/usr/bin/env bash
# Checks before each push to GitHub, so a mistake shows up here rather than in GitHub's
# checks after it's public: the quick tests (scripts/test-helpers.sh), and when the push
# changes anything lint.sh looks at, scripts/lint.sh too (shellcheck and the rest), side
# by side: about 7 seconds (2 for settings or docs). It checks the commits being pushed,
# unpacked into a temporary folder, not the files as they are now, so edits you haven't
# committed don't count either way. Stops the push if a check fails.
#
# install.sh points the Obsidian vault at this folder too (for the secret check): for any
# repo but the dotfiles this does nothing. scripts/test-vm.sh isn't run: it tests what's on
# GitHub, so it comes after the push (docs/maintenance.md).
# If you need to push anyway: git push --no-verify

set -uo pipefail

# needs_lint <file>...: does any of these changed files go through lint.sh?
needs_lint() {
  local f
  for f in "$@"; do
    case "$f" in
      *.sh|dot|.githooks/*|home/bash/.bashrc|system/etc/cron.*/*|*.py|site/*.js|\
      eslint.config.mjs|package.json|package-lock.json|.shellcheckrc) return 0 ;;
    esac
  done
  return 1
}
[[ "${BASH_SOURCE[0]}" == "$0" ]] || return 0   # sourced (scripts/test-helpers.sh): only the function

DOTFILES="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
[[ "$(git rev-parse --show-toplevel 2>/dev/null)" == "$DOTFILES" ]] || exit 0

zero=0000000000000000000000000000000000000000
checked=" " rc=0 tmp=""
trap '[[ -n "$tmp" ]] && rm -rf "$tmp" "$tmp".*.out' EXIT
# Git passes one line per branch being pushed: <local ref> <local id> <remote ref> <remote id>.
while read -r _ local_id _ remote_id; do
  [[ "$local_id" == "$zero" || "$checked" == *" $local_id "* ]] && continue   # deleting a branch, or done
  checked+="$local_id "
  # What changed since GitHub's copy; everything, if GitHub doesn't have the branch yet.
  lint=1
  if [[ "$remote_id" != "$zero" ]] && git cat-file -e "$remote_id^{commit}" 2>/dev/null; then
    mapfile -t changed < <(git diff --name-only "$remote_id" "$local_id")
    needs_lint "${changed[@]}" || lint=0
  fi

  tmp="$(mktemp -d)"
  # Nothing is shared with the repo itself, not even node_modules: lint.sh installs ESLint's
  # packages into the temporary folder (from npm's cache, a second or so), and its npm ci
  # empties the node_modules it's given.
  git archive "$local_id" | tar -x -C "$tmp"
  (
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX   # (git init below: not this repo)
    cd "$tmp" && git init -q && git add -A   # lint.sh lists the website's scripts with git
    echo "Checking what you're pushing (${local_id:0:7}):"
    # Both at once (lint.sh spreads shellcheck over the cores too); each one's output goes to
    # a file beside the copy, shown only if it fails.
    checks=(scripts/test-helpers.sh)
    if (( lint )); then checks=(scripts/lint.sh "${checks[@]}")
    else echo "  – scripts/lint.sh: nothing it checks has changed"; fi
    # failures <output>: what failed. The tests' ✘ lines, each with the two lines before it
    # (a check's "expected" and "got"); for lint.sh, which says why above its ✘ line, the end.
    failures() {
      if grep -q '^  ✘ ' "$1"; then grep -B2 '^  ✘ ' "$1" | grep -v '^--$' | head -40; tail -1 "$1"
      else tail -40 "$1"; fi
    }
    declare -A pid
    # Each in a clean environment, as in GitHub's checks: only these few settings, none from
    # whatever is pushing (dot check's fixes pass on their answers, their progress panel and
    # their own settings, which made the tests fail when a push came from there).
    clean_env=(env -i HOME="$HOME" PATH="$PATH" USER="${USER:-}" LANG="${LANG:-C.UTF-8}"
               TERM="${TERM:-dumb}" TMPDIR="${TMPDIR:-/tmp}" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}")
    for c in "${checks[@]}"; do "${clean_env[@]}" bash "$c" > "$tmp.${c##*/}.out" 2>&1 & pid[$c]=$!; done
    [[ -t 1 ]] && printf '  … %s' "${checks[*]}"   # in a terminal, replaced by the results
    ok=0 first=1
    for c in "${checks[@]}"; do
      wait "${pid[$c]}"; rc=$?
      (( first )) && [[ -t 1 ]] && printf '\r\e[K'; first=0
      if (( rc == 0 )); then printf '  ✔ %s\n' "$c"
      else printf '  ✘ %s\n' "$c"; failures "$tmp.${c##*/}.out" | sed 's/^/      /'; ok=1; fi
    done
    exit "$ok"
  ) || rc=1
  rm -rf "$tmp" "$tmp".*.out; tmp=""
done

if (( rc )); then
  echo
  echo "Push stopped: fix what failed above, commit, and push again."
  echo "To push anyway: git push --no-verify"
fi
exit "$rc"
