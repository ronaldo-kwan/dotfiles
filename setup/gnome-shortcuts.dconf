[/]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/claude/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/vscode/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/obsidian/']
home=['<Super>f']
rotate-video-lock-static=['XF86RotationLockToggle']
terminal=['<Super>t']
www=['<Super>b']

[custom-keybindings/claude]
binding='<Super>x'
command='claude-desktop'
name='Claude'

[custom-keybindings/obsidian]
binding='<Super>o'
command='flatpak run md.obsidian.Obsidian'
name='Obsidian'

[custom-keybindings/vscode]
binding='<Super>e'
command='code'
name='VS Code'
