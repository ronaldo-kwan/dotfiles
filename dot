#!/usr/bin/env bash
# dot: one command for everything in ~/dotfiles. `dot` alone opens a menu (with gum);
# `dot help` lists the commands.
# (`dot cd` is handled by the dot() function in .bashrc, since a script can't
# change your terminal's folder.)

set -uo pipefail
# shellcheck source=lib.sh
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib.sh"   # repo_state, ask, VAULT, DOTFILES
# The scripts dot starts take its place: give them the full look (title box, summary)
# and their own log, as if you'd run them directly.
export UI_DEPTH="$UI_NESTED"
unset UI_LOG

usage() {
  printf '\n%sdot%s: your dotfiles in one command\n\n' "$C_ACC$C_B" "$C_N"
  while IFS='|' read -r cmd what; do
    if [[ -z "$cmd" ]]; then printf '\n'; continue; fi
    printf '  %s%-23s%s %s\n' "$C_B" "$cmd" "$C_N" "$what"
  done <<'EOF'
dot|Menu: pick any of these with the arrow keys (needs gum)
dot push [message]|Save to GitHub: refresh the snapshots, commit, push (and your notes)
dot pull|Get changes saved from another computer, then apply them
dot check|Health check, then offers to fix each problem (asks first)
dot save|Only refresh the snapshots in setup/ and show what changed
|
dot install|Configs, fonts, Flatpak apps, extensions, settings (install.sh)
dot apps|Apps, NVIDIA driver, weekly updates, firewall (install-apps.sh)
dot fresh|Set up a freshly installed Ubuntu (fresh-install.sh)
dot upgrade|After upgrading Ubuntu to a new release (post-upgrade.sh)
dot ssh|SSH key for this computer, and signed (Verified) commits
dot uninstall [--apps]|Undo the dotfiles: links, desktop look (--apps: the apps too)
|
dot cd|Go to ~/dotfiles
dot edit|Open ~/dotfiles in VS Code
dot help|This list
EOF
  printf '\n  %sOptions go to the script: dot apps --yes, dot install --yes%s\n\n' "$C_DIM" "$C_N"
}

# push_repo <folder> <default message> [message...]: commit everything and push.
push_repo() {
  local dir="$1" default="$2" name="${1/#$HOME/\~}"; shift 2
  local msg="${*:-$default}" behind
  # Not on a branch (set up from a release by an older bootstrap.sh), or GitHub has commits
  # this computer doesn't: a push would be refused, so get them first.
  behind="$(git -C "$dir" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
  if ! git -C "$dir" symbolic-ref -q HEAD >/dev/null || (( behind > 0 )); then
    printf '%s✘%s %s has newer commits on GitHub. Get them first: dot pull, then dot push\n' "$C_ERR" "$C_N" "$name"
    return 1
  fi
  case "$(repo_state "$dir")" in
    "")       printf '%s✔%s nothing to save in %s\n' "$C_OK" "$C_N" "$name"; return ;;
    unpushed) git -C "$dir" push && printf '%s✔%s pushed %s\n' "$C_OK" "$C_N" "$name"; return ;;
  esac
  git -C "$dir" status --short
  git -C "$dir" add -A && git -C "$dir" commit -q -m "$msg" && git -C "$dir" push -q \
    && printf '%s✔%s saved to GitHub: %s\n' "$C_OK" "$C_N" "$(git -C "$dir" log --format='%h %s' -1)"
}

# snapshot: refresh the snapshots in setup/ (scripts/snapshot.sh).
snapshot() {
  bash "$DOTFILES/scripts/snapshot.sh" && return
  printf '%s!%s a snapshot couldn'"'"'t be refreshed (see above); it was left as it was\n' "$C_WARN" "$C_N"
  return 1
}

# pull_repo <folder>: get the commits saved from another computer, without merging (only
# fast-forwards). Returns 0 if something came down, 1 if there was nothing new, 2 if it
# couldn't pull.
pull_repo() {
  local dir="$1" before after name="${1/#$HOME/\~}"
  before="$(git -C "$dir" rev-parse HEAD 2>/dev/null)" || return 2
  if ! git -C "$dir" -c advice.diverging=false pull --ff-only --quiet; then
    printf '%s✘%s couldn'"'"'t pull %s (see above)\n' "$C_ERR" "$C_N" "$name"
    printf '  %sIf this computer has its own new commits too: git -C %s pull --rebase, then dot push%s\n' "$C_DIM" "$name" "$C_N"
    return 2
  fi
  after="$(git -C "$dir" rev-parse HEAD)"
  if [[ "$before" == "$after" ]]; then
    printf '%s✔%s %s is up to date\n' "$C_OK" "$C_N" "$name"; return 1
  fi
  printf '%s✔%s %s: %s new commit(s)\n' "$C_OK" "$C_N" "$name" "$(git -C "$dir" rev-list --count "$before..$after")"
  git -C "$dir" --no-pager log --format='    %h %s (%cr)' "$before..$after"
}

# --- The menu (dot alone, or dot menu) --------------------------------------------------
status_line() {
  local n last
  n=$(git -C "$DOTFILES" status --porcelain 2>/dev/null | wc -l)
  last="$(git -C "$DOTFILES" log -1 --format=%cr '@{u}' 2>/dev/null)"
  if (( n )); then printf '● %s unsaved change%s in ~/dotfiles: Push to save' "$n" "$( ((n > 1)) && echo s)"
  elif [[ -n "$(repo_state "$DOTFILES")" ]]; then printf '● commits not on GitHub yet: Push'
  else printf '✔ dotfiles saved'; fi
  [[ -n "$last" ]] && printf ' · last push %s' "$last"
  if [[ -d "$VAULT/.git" ]]; then
    if [[ -n "$(repo_state "$VAULT")" ]]; then printf '\n● notes not saved: Push'; else printf '\n✔ notes saved'; fi
  fi
}
menu() {
  local pick msg key items=(
    "Save to GitHub         dot push|push"
    "Get changes            dot pull|pull"
    "Health check and fix   dot check|check"
    "Apps and firewall      dot apps|apps"
    "Configs and desktop    dot install|install"
    "SSH and signing        dot ssh|ssh"
    "After Ubuntu upgrade   dot upgrade|upgrade"
    "Open in VS Code        dot edit|edit"
    "Quit|quit")
  while true; do
    clear
    printf '\n %s%sdotfiles%s\n\n' "$C_ACC" "$C_B" "$C_N"
    pick="$(gum choose --label-delimiter='|' --header "$(status_line)" --height 11 "${items[@]}")" || break
    echo
    case "$pick" in
      quit) break ;;
      push)
        msg="$(gum input --prompt "Commit message › " --placeholder "Update settings")" || continue
        "$DOTFILES/dot" push ${msg:+"$msg"} ;;
      edit) "$DOTFILES/dot" edit; continue ;;
      *)    "$DOTFILES/dot" "$pick" ;;
    esac
    printf '\n %sPress any key for the menu, q to quit%s ' "$C_DIM" "$C_N"
    read -rsn1 key; [[ "$key" == q ]] && break
  done
  echo
}

cmd="${1:-}"; [[ $# -gt 0 ]] && shift
if [[ -z "$cmd" || "$cmd" == menu ]]; then
  if ui_gum; then menu; exit 0; fi
  [[ "$cmd" == menu ]] && echo "The menu needs gum: sudo apt install gum"
  cmd=help
fi
case "$cmd" in
  save)
    snapshot || exit 1
    if [[ -z "$(git -C "$DOTFILES" status --porcelain)" ]]; then
      printf '%s✔%s snapshots refreshed; nothing changed\n' "$C_OK" "$C_N"
    else
      printf '%s✔%s snapshots refreshed. Changed:\n' "$C_OK" "$C_N"
      git -C "$DOTFILES" status --short
      printf '%sTo save them to GitHub: dot push%s\n' "$C_DIM" "$C_N"
    fi ;;
  push)
    # Snapshots first, so what's saved matches this computer. One that couldn't be
    # refreshed stays as it was, so the rest is still worth saving.
    snapshot
    push_repo "$DOTFILES" "Update settings" "$@"; rc=$?
    if [[ -d "$VAULT/.git" ]]; then push_repo "$VAULT" "Update notes" || rc=1; fi
    exit "$rc" ;;
  pull)
    start="$(git -C "$DOTFILES" rev-parse HEAD)"
    # Set up from a release by an older bootstrap.sh (not on a branch): back to main.
    git -C "$DOTFILES" symbolic-ref -q HEAD >/dev/null || git -C "$DOTFILES" checkout --quiet main || exit 1
    pull_repo "$DOTFILES"; rc=$?
    [[ -d "$VAULT/.git" ]] && pull_repo "$VAULT"
    (( rc == 2 )) && exit 1
    [[ "$(git -C "$DOTFILES" rev-parse HEAD)" != "$start" ]] || exit 0
    # Config files are links, so they're live already; settings, extensions and new
    # links need install.sh. New apps need install-apps.sh.
    changed="$(git -C "$DOTFILES" diff --name-only "$start" HEAD)"
    echo
    if ask "Apply the changes to this computer now (dot install)?"; then
      "$DOTFILES/install.sh" --yes
    else
      printf '  %sApply them later: dot install%s\n' "$C_DIM" "$C_N"
    fi
    if grep -qE '^(install-apps\.sh|setup/apt-packages\.txt)$' <<<"$changed"; then
      if ask "The app list changed. Install the new apps too (dot apps)?"; then
        "$DOTFILES/install-apps.sh"
      else
        printf '  %sInstall them later: dot apps%s\n' "$C_DIM" "$C_N"
      fi
    fi ;;
  check)   exec "$DOTFILES/check.sh" "$@" ;;
  install) exec "$DOTFILES/install.sh" "$@" ;;
  apps)    exec "$DOTFILES/install-apps.sh" "$@" ;;
  fresh)   exec "$DOTFILES/fresh-install.sh" "$@" ;;
  upgrade) exec "$DOTFILES/post-upgrade.sh" "$@" ;;
  ssh)     exec "$DOTFILES/scripts/ssh-setup.sh" "$@" ;;
  uninstall) exec "$DOTFILES/uninstall.sh" "$@" ;;
  edit)    exec code "$DOTFILES" ;;
  help|-h|--help) usage ;;
  *) printf '%s✘%s unknown command: %s\n' "$C_ERR" "$C_N" "$cmd"; usage; exit 1 ;;
esac
