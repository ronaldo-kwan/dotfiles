[init]
	defaultBranch = main
[include]
	# Your name and email for commits: per person, asked once by install.sh (see
	# setup/git-identity), so nobody else using these dotfiles commits as you.
	path = ~/.config/git/user.gitconfig
[include]
	# Commit signing with this computer's SSH key, written by `dot ssh` (and install.sh
	# when a key exists). Git ignores it while the file doesn't exist.
	path = ~/.config/git/signing.gitconfig
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
