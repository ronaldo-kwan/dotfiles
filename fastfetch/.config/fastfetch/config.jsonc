// fastfetch: system info next to the Ubuntu logo, in Catppuccin Mocha colours with
// Nerd Font icons. Run `fastfetch`; options: fastfetch --help-format, or the schema below.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": { "top": 1, "left": 2, "right": 3 },
    "color": { "1": "38;2;250;179;135", "2": "38;2;243;139;168" }   // peach and red
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;137;180;250",      // blue
      "title": "38;2;203;166;247",     // mauve
      "separator": "38;2;108;112;134"  // overlay0
    },
    "key": { "width": 14 },
    "bar": { "char": { "elapsed": "■", "total": "·" }, "width": 12 },
    "percent": { "type": ["num", "bar"], "color": { "green": "38;2;166;227;161", "yellow": "38;2;249;226;175", "red": "38;2;243;139;168" } }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[38;2;69;71;90m──────────────────────────────────────" },
    { "type": "os", "key": " System" },
    { "type": "kernel", "key": " Kernel" },
    { "type": "uptime", "key": "󰅐 Uptime" },
    { "type": "packages", "key": "󰏖 Packages" },
    { "type": "de", "key": " Desktop" },
    { "type": "terminal", "key": " Terminal" },
    { "type": "terminalfont", "key": " Font" },
    { "type": "shell", "key": " Shell" },
    { "type": "custom", "format": "\u001b[38;2;69;71;90m──────────────────────────────────────" },
    { "type": "cpu", "key": " CPU", "temp": false },
    { "type": "gpu", "key": "󰢮 GPU" },
    { "type": "memory", "key": " Memory" },
    { "type": "disk", "key": "󰋊 Disk", "folders": "/" },
    { "type": "battery", "key": "󰁹 Battery" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
