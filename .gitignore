# Backups made by install.sh or by hand
*.orig
*.bak
*.bak-*

# Editor leftovers
*~
*.swp
*.swo

# Logs that apps may write next to their config
*.log

# Never commit secrets (sign-ins, keys, tokens)
.env
*.pem
*.key
id_rsa*
id_ed25519*

# Generated by scripts/build-site.py (the website workflow builds them)
site/options.json
site/docs.json

# Obsidian community plugins: program files and their own settings (which can hold API
# keys). Only the list of plugins (community-plugins.json) is saved. See save-app-settings.sh.
setup/apps/obsidian/plugins/
